<Window x:Class="NastaliqStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastaliq Studio" Height="820" Width="1280" MinHeight="620" MinWidth="900"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#F2F1F6" PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#343149"/>
            <Setter Property="BorderBrush" Value="#E2E0E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#25233A"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#25233A">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="31" Height="31" CornerRadius="8" Background="#7655D9" Margin="0,0,9,0">
                        <TextBlock Text="ن" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Nastaliq Studio" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="URDU WRITING &amp; EXAM PAPERS" Foreground="#B9B5CB" FontSize="9"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open" Style="{StaticResource ToolButton}" Click="Open_Click"/>
                    <Button Content="Save" Style="{StaticResource ToolButton}" Click="Save_Click"
                            Background="#7655D9" Foreground="White" BorderBrush="#7655D9"/>
                    <Button Content="Export PDF" Style="{StaticResource ToolButton}" Click="ExportPdf_Click"/>
                    <Button Content="Minimize" Style="{StaticResource ToolButton}" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Content="Maximize" Style="{StaticResource ToolButton}" Click="Maximize_Click"/>
                    <Button Content="Close" Style="{StaticResource ToolButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E3EB" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Button Content="New" Style="{StaticResource ToolButton}" Click="New_Click"/>
                    <Button Content="Make an exam" Style="{StaticResource ToolButton}"
                            Click="CreateExam_Click" Background="#F0ECFB" Foreground="#6245BA"/>
                    <Separator Margin="7,7"/>
                    <Button Content="Undo" Style="{StaticResource ToolButton}" Click="Undo_Click"/>
                    <Button Content="Redo" Style="{StaticResource ToolButton}" Click="Redo_Click"/>
                    <Separator Margin="7,7"/>
                    <ComboBox x:Name="FontFamilyBox" Width="150" Height="32" Margin="3"
                              SelectionChanged="FontFamily_Changed" ToolTip="Font family">
                        <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                        <ComboBoxItem Content="Arial"/>
                        <ComboBoxItem Content="Tahoma"/>
                        <ComboBoxItem Content="Times New Roman"/>
                        <ComboBoxItem Content="Traditional Arabic"/>
                        <ComboBoxItem Content="Noto Naskh Arabic"/>
                    </ComboBox>
                    <ComboBox x:Name="FontSizeBox" Width="72" Height="32" Margin="3"
                              SelectionChanged="FontSize_Changed" ToolTip="Font size">
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="20" IsSelected="True"/>
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="28"/>
                        <ComboBoxItem Content="32"/>
                        <ComboBoxItem Content="40"/>
                        <ComboBoxItem Content="48"/>
                    </ComboBox>
                    <Button Content="B" FontWeight="Bold" Style="{StaticResource ToolButton}" Click="Bold_Click"/>
                    <Button Content="I" FontStyle="Italic" Style="{StaticResource ToolButton}" Click="Italic_Click"/>
                    <Button Content="Underline" Style="{StaticResource ToolButton}" Click="Underline_Click"/>
                    <Button Content="Highlight" Style="{StaticResource ToolButton}" Click="Highlight_Click"/>
                    <Button Content="Text color" Style="{StaticResource ToolButton}" Click="TextColor_Click"/>
                    <Button Content="Right align" Style="{StaticResource ToolButton}" Click="AlignRight_Click"/>
                    <Button Content="Center" Style="{StaticResource ToolButton}" Click="AlignCenter_Click"/>
                    <Button Content="RTL" Style="{StaticResource ToolButton}" Click="Direction_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="170"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="205" MinWidth="160"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E3EB" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="13">
                        <TextBlock Text="Urdu keyboard" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Click a letter to insert it at the cursor."
                                   Foreground="#77758A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ToggleButton x:Name="UrduModeToggle" Content="Urdu typing: ON" IsChecked="True"
                                      Checked="UrduMode_Changed" Unchecked="UrduMode_Changed"
                                      Height="32" Background="#F0ECFB" Foreground="#6245BA"
                                      BorderBrush="#DFD7F6" Margin="0,0,0,9"/>
                        <UniformGrid x:Name="KeyboardGrid" Columns="5" Margin="0,0,0,9"/>
                        <TextBlock Text="Map a keyboard key" Style="{StaticResource PanelTitle}" FontSize="12"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="MappingKeyBox" Grid.Column="0" ToolTip="Latin key"
                                     Height="30" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="MappingValueBox" Grid.Column="1" ToolTip="Urdu letter or word"
                                     Height="30" Margin="4,0,0,0" VerticalContentAlignment="Center"
                                     FlowDirection="RightToLeft"/>
                        </Grid>
                        <Button Content="Save mapping" Style="{StaticResource ToolButton}"
                                Click="SaveMapping_Click"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Islamic symbols" Style="{StaticResource PanelTitle}" FontSize="12"/>
                        <UniformGrid x:Name="SymbolsGrid" Columns="3"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Background="#EAE9EF">
                <ScrollViewer x:Name="DocumentScroll" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="440" MinHeight="560" Margin="18">
                        <RichTextBox x:Name="Editor" Width="794" MinHeight="1123"
                                     HorizontalAlignment="Center" VerticalAlignment="Top"
                                     Background="White" BorderBrush="#DAD8E2" BorderThickness="1"
                                     Padding="40" FontFamily="Segoe UI" FontSize="20"
                                     VerticalScrollBarVisibility="Hidden"
                                     HorizontalScrollBarVisibility="Disabled"
                                     AcceptsTab="True" SpellCheck.IsEnabled="False"
                                     SelectionChanged="Editor_SelectionChanged"
                                     PreviewTextInput="Editor_PreviewTextInput"
                                     PreviewKeyDown="Editor_PreviewKeyDown"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E3EB" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="13">
                        <TextBlock Text="Writing tools" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Select text, then apply highlighting or formatting."
                                   Foreground="#77758A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Text color" Foreground="#555267" FontSize="11" Margin="0,0,0,5"/>
                        <WrapPanel x:Name="ColorPalette" Margin="0,0,0,10"/>
                        <TextBlock Text="Highlight color" Foreground="#555267" FontSize="11" Margin="0,0,0,5"/>
                        <WrapPanel x:Name="HighlightPalette" Margin="0,0,0,12"/>
                        <Separator Margin="0,3,0,10"/>
                        <TextBlock Text="Exam paper" Style="{StaticResource PanelTitle}" FontSize="12"/>
                        <TextBlock Text="Click Make an exam, fill out the setup form, then press Do it to create an editable Urdu exam sheet."
                                   Foreground="#77758A" FontSize="11" TextWrapping="Wrap" LineHeight="19"/>
                        <Separator Margin="0,12,0,10"/>
                        <TextBlock Text="Shortcuts" Style="{StaticResource PanelTitle}" FontSize="12"/>
                        <TextBlock Text="Ctrl+N  New document&#10;Ctrl+O  Open&#10;Ctrl+S  Save&#10;Ctrl+P  Export PDF&#10;Ctrl+B / I / U&#10;Ctrl+Z / Y"
                                   Foreground="#77758A" FontSize="11" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#25233A">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="StatusText" Text="Ready · A4 document"
                           Foreground="#D4D1E0" VerticalAlignment="Center" FontSize="10"/>
                <TextBlock DockPanel.Dock="Right" Text="Resize, minimize, maximize, or close using the window controls"
                           Foreground="#A5A1B7" VerticalAlignment="Center" FontSize="9"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
